import os
import json
import re
from typing import List, Dict, Any

# ==========================================
# 1. 路径配置 (自动定位)
# ==========================================
# 当前文件位于: src/adk_agent/skills/experience_library/tools.py
# 向上回溯 4 层找到 Project Root
CURRENT_DIR = os.path.dirname(os.path.abspath(__file__))
PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(CURRENT_DIR))))

# 经验池根目录
SHARED_GENE_POOL = os.path.join(PROJECT_ROOT, "agent_experiences")
# 全局索引文件 (L0 Index - 只有这个会被预加载)
EXPERIENCE_INDEX_PATH = os.path.join(SHARED_GENE_POOL, "index_manifest.json")

def search_experience_library(query: str) -> str:
    """
    [Tool] 本地经验图书馆检索工具。
    
    【使用场景】：
    1. 当你执行代码遇到报错 (Traceback/Error) 时。
    2. 当你不确定某个内网工具的配置命令时。
    3. 当你想知道以前是否解决过类似问题时。
    
    【工作原理】：
    它会先搜索轻量级索引，根据报错特征和语义相似度匹配，然后懒加载具体的解决方案。
    
    Args:
        query: 具体的报错信息 (如 "Connection refused: port 8080") 或 问题描述 (如 "how to config git proxy")。
        
    Returns:
        返回找到的最佳经验内容（包含原因分析和修复代码），或者未找到的提示。
    """
    # 0. 基础环境检查
    if not os.path.exists(EXPERIENCE_INDEX_PATH):
        return "【系统提示】本地经验库尚未建立索引 (index_manifest.json 不存在)，暂无可用经验。"

    print(f"[Experience Lib] 正在检索索引 (L0 Layer), Query: {query[:50]}...")

    # 1. 加载索引 (L0 Layer) - 极快，只读内存
    try:
        with open(EXPERIENCE_INDEX_PATH, 'r', encoding='utf-8') as f:
            manifest = json.load(f) # type: Dict[str, Dict]
    except Exception as e:
        return f"【系统错误】索引文件损坏或无法读取: {e}"

    if not manifest:
        return "【系统提示】经验库目前为空，还没有任何记录。"

    # ==========================================
    # 2. 分层评分逻辑 (Weighted Scoring)
    # ==========================================
    scored_items = []
    
    # 预处理查询：转小写，提取单词集合
    query_lower = query.lower()
    query_words = set(re.findall(r'\w+', query_lower))
    
    for gene_id, meta in manifest.items():
        score = 0
        
        # A. 【致命一击】正则/报错特征完全包含 (权重: 100)
        # 逻辑：如果库里的报错特征直接出现在了查询里，这几乎就是同一个问题
        error_regex = meta.get('error_regex', '').lower()
        if error_regex and error_regex in query_lower:
            score += 100 
            
        # B. 【主题相关】标题匹配 (权重: 50)
        # 逻辑：虽然报错不一样，但大家都在聊同一个 Title
        title = meta.get('title', '').lower()
        if title and title in query_lower:
            score += 50
            
        # C. 【上下文相似】标签/关键词交集 (权重: 每个词 10 分)
        # 逻辑：计算查询词和经验标签的重叠度
        keywords = [k.lower() for k in meta.get('keywords', [])]
        if keywords:
            common_tags = set(keywords) & query_words
            score += len(common_tags) * 10
        
        # 只有当分数大于 0 时才认为是候选
        if score > 0:
            scored_items.append((score, meta))

    # ==========================================
    # 3. 排序与决策
    # ==========================================
    if not scored_items:
        return f"在本地经验库中未找到与 '{query[:50]}...' 相关的解决方案。请尝试自行分析或更换关键词搜索。"
        
    # 按分数从高到低排序 (取第一名)
    scored_items.sort(key=lambda x: x[0], reverse=True)
    
    # 解包：拿到分数和元数据
    best_score, best_meta = scored_items[0]
    
    # 调试日志
    print(f"[Experience Lib] 索引命中: {best_meta.get('title')} (得分: {best_score}) | 指针: {best_meta.get('path')}")

    # 【阈值控制】如果分数太低 (比如只命中了一个通用词 "error")，则不推荐
    if best_score < 15:
        return f"找到一条经验但匹配度过低 (置信度 {best_score})，系统判定为不相关，不予展示。"

    # ==========================================
    # 4. 懒加载正文 (Lazy Load L2 Content)
    # ==========================================
    # 只有确定要读取这一条了，才去读硬盘上的具体文件
    rel_path = best_meta.get('path', '')
    if not rel_path:
        return "【数据异常】索引命中，但文件路径字段丢失。"
        
    full_path = os.path.join(SHARED_GENE_POOL, rel_path)
    
    try:
        # 二次检查物理文件是否存在
        if not os.path.exists(full_path):
             return f"【系统错误】索引指向的文件不存在: {rel_path}"

        # 读取正文
        with open(full_path, 'r', encoding='utf-8') as f:
            full_data = json.load(f)
            
        # 提取核心内容
        content = full_data.get('content', {})
        context = content.get('problem_context', '无描述')
        solution = content.get('solution_action', {}).get('commands', [])
        reasoning = content.get('reasoning', '无')
        category = full_data.get('category', 'general')
        
        # 构造给 Agent 看的最终回复
        return f"""
✅ 已匹配到本地经验 (匹配度: {best_score})
📂 分类: {category} | 📄 ID: {best_meta.get('path')}
--------------------------------------------------
【历史问题】: {context}
【报错特征】: {best_meta.get('error_regex', 'N/A')}

【推荐解决方案 (已验证)】:
{json.dumps(solution, indent=2, ensure_ascii=False)}

【原理解析】: 
{reasoning}
--------------------------------------------------
💡 建议：请直接参考上述 JSON 中的 commands 修改你的代码或配置。
"""

    except json.JSONDecodeError:
        return f"【系统错误】经验文件损坏 (JSON Parse Error): {rel_path}"
    except Exception as e:
        return f"【系统错误】读取经验文件失败: {e}"

def get_tools(agent, session_service, app_info, **kwargs):
    """
    ADK 标准工具导出接口
    """
    return [search_experience_library]
